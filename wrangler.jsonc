// Cloudflare Workers config. Deploy: Cloudflare dashboard → Workers → Import a repository (this repo).
{
  "name": "funinvestments",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build-static.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/healthz"]
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "observability": { "enabled": true },
  // Settings for Cloudflare preview builds. Each preview gets its own empty saved state.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] }
  }
}
